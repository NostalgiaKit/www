# Copy to .env (or .env.development / .env.test) and fill in values.
# .env* files are git-ignored except this one. In production, set these as real
# environment variables (Kamal injects them from .kamal/secrets).

# Required in production. Generate with: bin/rails secret
# Development and test always use tmp/local_secret.txt, so leave it unset locally.
# SECRET_KEY_BASE=

# Optional: Active Storage on S3 (see config/storage.yml)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional: outgoing mail (see config/environments/production.rb)
# SMTP_USER_NAME=
# SMTP_PASSWORD=

# Optional: Kamal registry password (see config/deploy.yml)
# KAMAL_REGISTRY_PASSWORD=
