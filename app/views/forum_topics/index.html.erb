<% content_for :title, "Forums" %>

<h1>Forums</h1>

<%# TODO: categories %>
<table class="listing">
  <thead>
    <tr>
      <th>Topic</th>
      <th>Started by</th>
    </tr>
  </thead>

  <tbody>
    <% @topics.each do |topic| %>
      <tr>
        <td><%= link_to topic.title, forum_topic_path(topic) %></td>
        <td><%= topic.author.username %></td>
      </tr>
    <% end %>
  </tbody>
</table>
